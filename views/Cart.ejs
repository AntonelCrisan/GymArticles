<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My cart</title>
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="icon" type="image/png" href="images/logo.png">
<!-- Font Awesome CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">
<link rel="stylesheet" href="style/Cart.css">

</head>
<body style="background-color: #f5f5f5;">
    <div class="navbar">
        <%- include('Navbar') %>
    </div>
    <div class="container-cart">
        <div class="col-lg cart">
            <h2 class="mb-4">My cart</h2>
             <% if (nrCart && nrCart > 0) { %>
                <div class="container">
                    <div class="row">
                        <% cart.forEach(element => { %>
                          <div class="mb-4 col-12">
                            <div class="cart-card">
                              <div class="product-image">
                                <img src="<%= element.image %>" alt="<%= element.name %>" width="150" height="150" style="max-width: 100%; height: auto;">
                              </div>
                              <div class="article-info">
                                <a href="/product?name=<%= element.name %>&id=<%= element._id %>" class="text-decoration-none text-dark product-container">
                                  <h5><%= element.name %></h5>
                                </a>
                                <% if (element.cantity > 0) { %>
                                  <p class="text-success">In stock</p>
                                <% } else { %>
                                  <p class="text-danger">Not available in stock</p>
                                <% } %>
                                <div>The order will arrive in 2 days</div>
                              </div>
                              <div class="price-cantity last">
                                <div class="text-decoration-none text-dark price"><strong>$<%= element.price * element.quantity %></strong></div>
                                <div class="qty-container">
                                  <button type="button" disabled class="btn-minus" id="decreaseCantityButton" data-id="<%=element._id%>">
                                    -
                                  </button>
                                  <span class="qty-value"><%= element.quantity %></span>
                                  <input class="hidden" type="number" min="1" max="10" value="<%= element.quantity %>" step="1" readonly="" name="quantity">
                                  <button type="button" class="btn-plus" id="increaseCantityButton" data-id="<%=element._id%>">
                                    +
                                  </button>
                                </div>
                                <div class="buttons">
                                  <button class="deleteFavoriteButton" id="deleteFromCart" data-id="<%= element._id %>" style="display: flex; align-items: center; justify-content: center; gap: 5px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#ffffff"><path d="M312-144q-29.7 0-50.85-21.15Q240-186.3 240-216v-480h-48v-72h192v-48h192v48h192v72h-48v479.57Q720-186 698.85-165T648-144H312Zm336-552H312v480h336v-480ZM384-288h72v-336h-72v336Zm120 0h72v-336h-72v336ZM312-696v480-480Z"/></svg>
                                    Delete
                                  </button>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                      <div class="swiper">
                        <h3>Frequently purchased products</h3>
                        <div class="swiper-container-recommended">
                            <div class="swiper-wrapper">
                                <% products.forEach(product => { %>
                                    <div class="swiper-slide col-lg-3 col-md-4 mb-4 col-sm-6 filtrable-card">
                                        <div class="card">
                                            <div class="card-body">
                                                <a href="/product?name=<%= product.name %>&id=<%= product._id %>" class="article">
                                                    <img src="<%= product.image %>" alt="img" style="max-width: 100%; height: auto;">
                                                    <h5 class="card-title" id="name" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 10px;"><%=  product.name %></h5>
                                                    <ul class="rating">
                                                        <span class="fa fa-star checked"></span>
                                                        <span class="fa fa-star checked"></span>
                                                        <span class="fa fa-star checked"></span>
                                                        <span class="fa fa-star checked"></span>
                                                        <span class="fa fa-star"></span>
                                                    </ul>
                                                    <p id="price"><strong><%= product.price %>$</strong></p>
                                                </a>
                                                <button class="btn btn-primary" id="addToCartButton" data-product-id="<%= product._id %>">
                                                    <span>
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="#ffffff"><path d="M466.43-615.63v-123h-124v-60h124v-123h60v123h123v60h-123v123h-60ZM289.79-77.37Q260-77.37 239-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm404 0Q664-77.37 643-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm-634.42-740v-65.26h120.54L348.48-521.5h286.99l158.86-277.13h73.45l-162.95 304.2q-11.48 19.47-29.51 31.45Q657.3-451 635.4-451H334.11l-54.33 101.37h488.85v65.26H284q-39.34 0-59.72-31.31-20.39-31.32-2.67-63.75L284.89-496 138.33-817.37H59.37Z"/></svg>
                                                    </span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="swiper-button-next swiper-button-next-recommended"></div>
                            <div class="swiper-button-prev swiper-button-prev-recommended"></div>
                            <div class="swiper-pagination swiper-pagination-recommended"></div>
                        </div>
                            
                    </div>
                </div>
                
            <% } else { %> 
                <div class="container text-center">
                  <div class="mb-4 col-lg">
                    <span>
                      <svg xmlns="http://www.w3.org/2000/svg" height="100px" viewBox="0 -960 960 960" width="100px" fill="#06b6d4"><path d="M286.79-78.37Q257-78.37 236-99.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm400 0Q657-78.37 636-99.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21ZM206.67-803.63h582.14q26.13 0 39.76 23.63 13.63 23.63.19 47.5L697.83-496.43q-11.48 19.47-29.51 31.45Q650.3-453 628.4-453H327.11l-54.33 101.37h488.85v65.26H277q-43.91 0-63.13-29.43-19.22-29.44.74-65.63L277.89-498 127.33-817.37H48.37v-65.26h121.3l37 79Z"/></svg>
                  </span>
                  <h2 class="mt-3">Your cart has no products</h2>
                  <div class="mt-2">For adding products to your cart please <a href="/" style="color: #06b6d4;">go back to shop</a></div> 
                  </div>
              </div>
                
            <% } %>
        </div>
        <% if (nrCart && nrCart > 0) { %>
            <div class="order-summary">
                <h5>Order Summary</h5>
                <div class="summary-item">
                    <span class="label">Product Cost:</span>
                    <span class="amount">$<%= productCost.toFixed(2) %></span>
                </div>
                <div class="summary-item">
                    <span class="label">Delivery Cost:</span>
                    <% if (productCost >= 50) { %>
                     <span class="text-success">FREE</span>
                    <% } else {%>
                    <span class="amount">$<%= deliveryCost %></span>
                    <% } %>
                </div>
                <div class="summary-item total">
                    <span class="label">Total:</span>
                    <% if (productCost >= 50) { %>
                        <span class="amount">$<%= productCost.toFixed(2) %></span>
                    <% } else {%>
                        <span class="amount">$<%= (productCost + deliveryCost).toFixed(2)%></span>
                    <% } %>
                </div>
                <a href="/checkout">
                  <button class="continue-button">Continue</button>
                </a>
            </div>
        <% } %>
    </div>
    <div class="footer">
        <%- include('Footer') %>
    </div>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="scripts/cart/deleteProductFromCart.js"></script>
<script src="scripts/cart/increaseAndDecreaseCantity.js"></script>
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  window.onload = function () {
   new Swiper('.swiper-container-recommended', {
       slidesPerView: 5,
       slidesPerGroup: 5,
       navigation: {
           nextEl: '.swiper-button-next-recommended',
           prevEl: '.swiper-button-prev-recommended',
       },
       pagination: {
           el: '.swiper-pagination-recommended',
           clickable: true,
       },
       loop: false,
       breakpoints: {
           1024: { slidesPerView: 5, slidesPerGroup: 5 },
           768: { slidesPerView: 3, slidesPerGroup: 3 },
           480: { slidesPerView: 2, slidesPerGroup: 2 }
       }
   });
};
   
</script>
</body>
</html>