<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GymArticles</title>
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<!-- Font Awesome CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">

<link rel="stylesheet" type="text/css" href="style/HomePage.css">
<link rel="icon" type="image/png" href="images/logo.png">
<!-- Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</head>
<body style="background-color: #f5f5f5;">
<%- include('Navbar') %>
<div>
    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel" data-interval="4000">
        <ol class="carousel-indicators">
          <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="3"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="4"></li>
        </ol>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="/images/Banner4_gymarticles.jpg" class="d-block w-100 carousel-img-desktop" alt="Banner">
            <img src="/images/Banner4_mobile_gymarticles.jpg" class="d-block w-100 carousel-img-mobile" alt="Banner">
            </div>
            <div class="carousel-item ">
            <img src="/images/Banner1_gymarticles.jpg" class="d-block w-100 carousel-img-desktop" alt="Banner">
            <img src="/images/Banner1_mobile_gymarticles.jpg" class="d-block w-100 carousel-img-mobile" alt="Banner">
            </div>
            <div class="carousel-item ">
            <img src="/images/Banner2_gymarticles.jpg" class="d-block w-100 carousel-img-desktop" alt="Banner">
            <img src="/images/Banner2_mobile_gymarticles.jpg" class="d-block w-100 carousel-img-mobile" alt="Banner">
            </div>
            <div class="carousel-item ">
            <img src="/images/Banner3_gymarticles.jpg" class="d-block w-100 carousel-img-desktop" alt="Banner">
            <img src="/images/Banner3_mobile_gymarticles.jpg" class="d-block w-100 carousel-img-mobile" alt="Banner">
            </div>
            <div class="carousel-item ">
            <img src="/images/Banner5_gymarticles.jpg" class="d-block w-100 carousel-img-desktop" alt="Banner">
            <img src="/images/Banner5_mobile_gymarticles.jpg" class="d-block w-100 carousel-img-mobile" alt="Banner">
            </div> 
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      </div>
    
    <div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-4 col-md-6">
            <div class="sidebar">
                <!-- Meniu drop-down pentru sortare -->
                <h5 class="text-center mb-3">Category</h5>
                <ul class="list-unstyled">
                <% categories.forEach(cat => { %>
                    <li>
                    <details>
                        <summary><%= cat.category %></summary>
                        <% cat.subcategories.forEach(sub => { %>
                        <li>
                            <a href="/category-results/?category=<%= encodeURIComponent(cat.category) %>&subcategory=<%= encodeURIComponent(sub) %>">
                            <%= sub %>
                            </a>
                        </li>
                        <% }) %>
                    </details>
                    </li>
                <% }) %>
                </ul>
                    </div>
               
            <% if (user) { %>
                <% if (user.role === 'admin') { %>
                    <a href="/add-article" target="_blank" class="card-btn">
                        <button type="button" class="btn btn-primary">Add article</button>
                    </a>
                <% } else {%>
                    <div></div>
                    <% } %>
            <% } else { %>
             <div></div>
             <% } %>
        </div>
        <div class="swiper">
            <h3>Most Popular Now</h3>
            <div class="swiper-container-top15">
                <div class="swiper-wrapper">
                    <% topProducts.forEach(product => { %>
                        <div class="swiper-slide col-lg-3 col-md-4 mb-4 col-sm-6 filtrable-card">
                            <div class="card">
                                <div class="card-body">
                                    <span class="fa fa-heart heartIcon <%= favoriteProductsID.includes(product._id.toString()) ? 'clicked' : '' %>" id="addFavorite" data-product-id="<%= product._id %>"></span>
                                    <a href="/product?name=<%= product.name %>&id=<%= product._id %>" class="article">
                                        <img src="<%= product.image %>" alt="img" style="max-width: 100%; height: auto;">
                                        <h5 class="card-title" id="name" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 10px;"><%=  product.name %></h5>
                                        <ul class="rating">
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star checked"></span>
                                            <span class="fa fa-star"></span>
                                        </ul>
                                        <p id="price"><strong><%= product.price %>$</strong></p>
                                    </a>
                                    <button class="btn btn-primary" id="addToCartButton" data-product-id="<%= product._id %>"  data-bs-toggle="modal" data-bs-target="#myModal">
                                        <span>
                                            <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="#ffffff"><path d="M466.43-615.63v-123h-124v-60h124v-123h60v123h123v60h-123v123h-60ZM289.79-77.37Q260-77.37 239-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm404 0Q664-77.37 643-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm-634.42-740v-65.26h120.54L348.48-521.5h286.99l158.86-277.13h73.45l-162.95 304.2q-11.48 19.47-29.51 31.45Q657.3-451 635.4-451H334.11l-54.33 101.37h488.85v65.26H284q-39.34 0-59.72-31.31-20.39-31.32-2.67-63.75L284.89-496 138.33-817.37H59.37Z"/></svg>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <div class="swiper-button-next swiper-button-next-top15"></div>
                <div class="swiper-button-prev swiper-button-prev-top15"></div>
                <div class="swiper-pagination swiper-pagination-top15"></div>
            </div>
                
        </div>
            <% if (user) { %>
                <div class="swiper">
                    <h3>Inspired by Your Shopping</h3>
                    <div class="swiper-container-recommended">
                        <div class="swiper-wrapper">
                            <% top15ProductsRecomendations.forEach(product => { %>
                                <div class="swiper-slide col-lg-3 col-md-4 mb-4 col-sm-6 filtrable-card">
                                    <div class="card">
                                        <div class="card-body">
                                            <span class="fa fa-heart heartIcon <%= favoriteProductsID.includes(product._id.toString()) ? 'clicked' : '' %>" id="addFavorite" data-product-id="<%= product._id %>"></span>
                                            <a href="/product?name=<%= product.name %>&id=<%= product._id %>" class="article">
                                                <img src="<%= product.image %>" alt="img" style="max-width: 100%; height: auto;">
                                                <h5 class="card-title" id="name" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 10px;"><%=  product.name %></h5>
                                                <ul class="rating">
                                                    <span class="fa fa-star checked"></span>
                                                    <span class="fa fa-star checked"></span>
                                                    <span class="fa fa-star checked"></span>
                                                    <span class="fa fa-star checked"></span>
                                                    <span class="fa fa-star"></span>
                                                </ul>
                                                <p id="price"><strong><%= product.price %>$</strong></p>
                                            </a>
                                            <button class="btn btn-primary" id="addToCartButton" data-product-id="<%= product._id %>"  data-bs-toggle="modal" data-bs-target="#myModal">
                                                <span>
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="#ffffff"><path d="M466.43-615.63v-123h-124v-60h124v-123h60v123h123v60h-123v123h-60ZM289.79-77.37Q260-77.37 239-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm404 0Q664-77.37 643-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm-634.42-740v-65.26h120.54L348.48-521.5h286.99l158.86-277.13h73.45l-162.95 304.2q-11.48 19.47-29.51 31.45Q657.3-451 635.4-451H334.11l-54.33 101.37h488.85v65.26H284q-39.34 0-59.72-31.31-20.39-31.32-2.67-63.75L284.89-496 138.33-817.37H59.37Z"/></svg>
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="swiper-button-next swiper-button-next-recommended"></div>
                    <div class="swiper-button-prev swiper-button-prev-recommended"></div>
                    <div class="swiper-pagination swiper-pagination-recommended"></div>
                </div>
            <% } else {%>
                <div></div>
            <% } %>
        <!-- Lista de produse -->
        <div class="col-lg-12"  style="margin-top: 30px;">
            <div class="row">
            <% articles.forEach(element => { %>
                <!-- Aici puteți adăuga carduri pentru articole sportive -->
                <div class="col-lg-2 col-md-4 mb-4 col-sm-6 filtrable-card">
                    <div class="card" id="card">
                        <div class="card-body"> 
                            <span class="fa fa-heart heartIcon <%= favoriteProductsID.includes(element._id.toString()) ? 'clicked' : '' %>" id="addFavorite" data-product-id="<%= element._id %>"></span>
                            <a href="/product?name=<%= element.name %>&id=<%= element._id %>" class="article">
                                <div>
                                    <img src="<%= element.image %>" alt="img" style="max-width: 100%; height: auto;">
                                    <h5 class="card-title" id="name" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 10px;"><%=  element.name %></h5>
                                    <ul class="rating">
                                        <span class="fa fa-star checked"></span>
                                        <span class="fa fa-star checked"></span>
                                        <span class="fa fa-star checked"></span>
                                        <span class="fa fa-star checked"></span>
                                        <span class="fa fa-star"></span>
                                    </ul>
                                    <p id="price"><strong><%= element.price %>$</strong></p>
                                </div>
                            </a>
                            <button class="btn btn-primary" id="addToCartButton" data-product-id="<%= element._id %>"  data-bs-toggle="modal" data-bs-target="#myModal">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="25px" fill="#ffffff"><path d="M466.43-615.63v-123h-124v-60h124v-123h60v123h123v60h-123v123h-60ZM289.79-77.37Q260-77.37 239-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm404 0Q664-77.37 643-98.58t-21-51q0-29.79 21.21-50.79t51-21q29.79 0 50.79 21.21 21 21.22 21 51 0 29.79-21.21 50.79t-51 21Zm-634.42-740v-65.26h120.54L348.48-521.5h286.99l158.86-277.13h73.45l-162.95 304.2q-11.48 19.47-29.51 31.45Q657.3-451 635.4-451H334.11l-54.33 101.37h488.85v65.26H284q-39.34 0-59.72-31.31-20.39-31.32-2.67-63.75L284.89-496 138.33-817.37H59.37Z"/></svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>
    </div>
    <div>
        <% if (user) { %>
            <div id="added-favorite" class="added-favorite d-none">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#ff0000"><path d="m480-121-41-37q-106-97-175-167.5t-110-126Q113-507 96.5-552T80-643q0-90 60.5-150.5T290-854q57 0 105.5 27t84.5 78q42-54 89-79.5T670-854q89 0 149.5 60.5T880-643q0 46-16.5 91T806-451.5q-41 55.5-110 126T521-158l-41 37Z"/></svg>
                </span>
                   <div>The product was added to Favorites</div>
              </div>
        <% } %>
          <div id="removed-favorite" class="removed-favorite d-none">
            <span>
                <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#06b6d4"><path d="m480-121-41-37q-105.77-97.12-174.88-167.56Q195-396 154-451.5T96.5-552Q80-597 80-643q0-90.15 60.5-150.58Q201-854 290-854q57 0 105.5 27t84.5 78q42-54 89-79.5T670-854q89 0 149.5 60.42Q880-733.15 880-643q0 46-16.5 91T806-451.5Q765-396 695.88-325.56 626.77-255.12 521-158l-41 37Zm0-79q101.24-93 166.62-159.5Q712-426 750.5-476t54-89.14q15.5-39.13 15.5-77.72 0-66.14-42-108.64T670.22-794q-51.52 0-95.37 31.5T504-674h-49q-26-56-69.85-88-43.85-32-95.37-32Q224-794 182-751.5t-42 108.82q0 38.68 15.5 78.18 15.5 39.5 54 90T314-358q66 66 166 158Zm0-297Z"/></svg>
            </span>
               <div>The product was removed to Favorites</div>
          </div>
          <div id="product-outof-stock" class="product-outof-stock d-none">
            <span>
                <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#EA3323"><path d="M34.74-116.89 480-886.22l445.26 769.33H34.74Zm113.8-65.74h662.92L480-754.98 148.54-182.63Zm335.64-54.85q12.96 0 21.87-9.08 8.91-9.09 8.91-22.05t-9.09-21.75q-9.08-8.79-22.05-8.79-12.96 0-21.87 8.96-8.91 8.97-8.91 21.93 0 12.96 9.09 21.87 9.08 8.91 22.05 8.91ZM454-348h60v-222.09h-60V-348Zm26-120.8Z"/></svg>
            </span>
               <div>Product is out of stock</div>
          </div>
    </div>
    </div>
</div>
    
<%- include('Footer') %>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
   window.onload = function () {
   new Swiper('.swiper-container-top15', {
    slidesPerView: 'auto',
    spaceBetween: 10,
    freeMode: true, 
    navigation: {
        nextEl: '.swiper-button-next-top15',
        prevEl: '.swiper-button-prev-top15',
    },
    pagination: {
        el: '.swiper-pagination-top15',
        clickable: true,
    }
});

    new Swiper('.swiper-container-recommended', {
        slidesPerView: 'auto',
        spaceBetween: 10,
        freeMode: true,
        navigation: {
            nextEl: '.swiper-button-next-recommended',
            prevEl: '.swiper-button-prev-recommended',
        },
        pagination: {
            el: '.swiper-pagination-recommended',
            clickable: true,
        },
    });
};
    
</script>
</body>
</html>
