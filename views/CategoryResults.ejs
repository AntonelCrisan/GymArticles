<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subcategory %></title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="stylesheet" href="/style/CategoryResults.css">
</head>
<body style="background-color: #f5f5f5;">
    <%- include('Navbar') %>
  <div class="container mt-5">
     <div class="sidebar" style="margin-top: 80px;">
                <!-- Meniu drop-down pentru sortare -->
                <h5 class="text-center mb-3">Category</h5>
                <ul class="list-unstyled">
                <% categories.forEach(cat => { %>
                    <li>
                    <details>
                        <summary><%= cat.category %></summary>
                        <% cat.subcategories.forEach(sub => { %>
                        <li>
                            <a href="/category-results/?category=<%= encodeURIComponent(cat.category) %>&subcategory=<%= encodeURIComponent(sub) %>">
                            <%= sub %>
                            </a>
                        </li>
                        <% }) %>
                    </details>
                    </li>
                <% }) %>
                </ul>
                </div>
<div style="margin-top: 80px;"><%= results %> results found for <strong>"<%= subcategory %>"</strong></div>
  <% if (!subcategory) { %>
    <div class="text-danger">
      The article you are looking for does not exist!
    </div>
  <% } else { %>
    <div class="row gy-4">
      <% articles.forEach(element => { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-4">
          <div class="card h-100 shadow-sm" data-name="<%= element.subcategory %>">
            <div class="card-body d-flex flex-column justify-content-between">
              <span class="fa fa-heart heartIcon <%= favoriteProductsID.includes(element._id.toString()) ? 'clicked' : '' %>" id="addFavorite" data-product-id="<%= element._id %>"></span>
              <a href="/product?name=<%= element.name %>&id=<%= element._id %>" class="article text-decoration-none text-dark">
                <img src="<%= element.image %>" alt="img" class="img-fluid mb-3">
                <h5 class="card-title text-truncate"><%= element.name %></h5>
                <ul class="rating list-inline mb-2">
                  <li class="list-inline-item"><span class="fa fa-star checked"></span></li>
                  <li class="list-inline-item"><span class="fa fa-star checked"></span></li>
                  <li class="list-inline-item"><span class="fa fa-star checked"></span></li>
                  <li class="list-inline-item"><span class="fa fa-star checked"></span></li>
                  <li class="list-inline-item"><span class="fa fa-star"></span></li>
                </ul>
                <p class="card-text"><strong><%= element.price %>$</strong></p>
              </a>
              <a href="/product?name=<%= element.name %>&id=<%= element._id %>" class="btn btn-primary w-100 mt-auto">Buy</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
    <%- include('Footer') %>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
